{
  "name": "redshot",
  "version": "1.0.1",
  "description": "Утилита скриншотов для Windows 10",
  "main": "./out/main/index.js",
  "author": "RedShot",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build:vite": "electron-vite build",
    "pack": "electron-vite build && electron-builder --win --x64",
    "release": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "electron-updater": "^6.8.11",
    "koffi": "^2.11.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "vite": "^6.2.5"
  },
  "build": {
    "appId": "com.redshot.app",
    "productName": "RedShot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "node_modules/koffi/**",
      "node_modules/electron-updater/**",
      "node_modules/debug/**",
      "node_modules/graceful-fs/**",
      "node_modules/has-flag/**",
      "node_modules/js-yaml/**",
      "node_modules/lazy-val/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**",
      "node_modules/ms/**",
      "node_modules/sax/**",
      "node_modules/supports-color/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "ChimitovZ",
      "repo": "red-shot"
    },
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RedShot-${version}-setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RedShot",
      "deleteAppDataOnUninstall": false
    }
  }
}
