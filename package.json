{
  "name": "redshot",
  "version": "1.0.0",
  "description": "Утилита скриншотов для Windows 10",
  "main": "./out/main/index.js",
  "author": "RedShot",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build:vite": "electron-vite build",
    "pack": "electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "koffi": "^2.11.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "vite": "^6.2.5"
  },
  "build": {
    "appId": "com.redshot.app",
    "productName": "RedShot",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json",
      "node_modules/koffi/**"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RedShot-${version}-portable.exe"
    }
  }
}
